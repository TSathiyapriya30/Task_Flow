# ==============================================================
# TaskFlow - Example environment variables
# Copy this file to .env (or export these in your shell) and
# fill in real values for your local machine.
# NEVER commit a real .env file.
# ==============================================================

# ---- PostgreSQL connection ----
DB_URL=jdbc:postgresql://localhost:5432/taskflow
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# ---- JWT ----
# Must be a Base64-encoded string that decodes to at least 256 bits (32 bytes).
# Generate one with:
#   openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_A_GENERATED_BASE64_SECRET
JWT_EXPIRATION_MS=86400000

# ---- CORS ----
# Comma-separated list of origins allowed to call the API.
# This should match wherever you serve the frontend files from
# (e.g. VS Code Live Server, `python -m http.server`, etc).
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500

# ---- Server ----
SERVER_PORT=8080

# ---- Hibernate schema behavior (see README section on migrations) ----
# One of: none | validate | update | create | create-drop
DDL_AUTO=update

# ---- Logging ----
SHOW_SQL=false
